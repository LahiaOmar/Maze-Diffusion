{
  "experiments": [
    {
      "model": {
        "name": "UNet",
        "parameters": {
          "simple_size": 28,
          "embedding_num": 3,
          "embedding_dim":784
        }
      },
      "scheduler": {
        "name": "DDPMs",
        "timesteps": 500,
        "beta_schedule": "linear"
      },
      "training": {
        "epochs": 200,
        "dataset_path": "./datasets"
      },
      "use_validation": false
    }
  ]
}